<?xml version="1.0"?>
<!DOCTYPE tsung SYSTEM "/usr/local/share/tsung/tsung-1.0.dtd">

<tsung loglevel="notice" version="1.0">
    <clients>
        <client host="localhost" use_controller_vm="true" maxusers="10000"/>
    </clients>

    <servers>
        <server host="nginx" port="80" type="tcp"/>
    </servers>

    <load>
        <!-- Сценарий 4: стресс -->
        <arrivalphase phase="4" duration="30" unit="second">
            <users interarrival="0.1" unit="second"/>
        </arrivalphase>
    </load>

    <sessions>
        <session name="slow" probability="100" type="ts_http">
            <for from="1" to="300" var="i">
                <thinktime random="true" value="0.1"/>
                <request subst="true">
                    <http url="/api/v1/iot/device/1/data"
                          method="POST"
                          version="1.1"
                          content_type="application/json"
                          contents_from_file="/tsung/config/data.json"/>
                </request>
            </for>
        </session>
    </sessions>
</tsung>